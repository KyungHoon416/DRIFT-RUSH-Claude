rules_version = '2';
// DRIFT RUSH Firestore rules. Clients may only edit their own profile fields.
// Rooms, results and records are written exclusively by Cloud Functions (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['nickname', 'kartColor', 'settings'])
        && (!('nickname' in request.resource.data) || (request.resource.data.nickname is string
            && request.resource.data.nickname.size() >= 2 && request.resource.data.nickname.size() <= 12));
      allow delete: if false;

      match /records/{map} { allow read: if signedIn(); allow write: if false; }
      match /friends/{fid} { allow read: if isSelf(uid); allow write: if false; }
    }

    match /rooms/{code} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow write: if false;
    }

    match /results/{session}/players/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
